<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_loader" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jvm_title"
                    android:textColor="@color/rf_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/jvm_edition"
                    android:textColor="@color/rf_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/panel_background_emphasis"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/readiness_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/jvm_setup_badge"
                android:textAllCaps="true"
                android:textColor="@color/rf_status_warning"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/readiness_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/jvm_setup_message"
                android:textColor="@color/rf_text_primary"
                android:textSize="17sp" />

            <Button
                android:id="@+id/launch_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/rf_accent"
                android:enabled="false"
                android:text="@string/jvm_launch_unavailable"
                android:textAllCaps="false"
                android:textColor="@color/rf_button_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/operation_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/rf_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/operation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/rf_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jvm_environment_title"
                android:textColor="@color/rf_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/jvm_game_checking"
                android:textColor="@color/rf_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/import_game_button"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/rf_control"
                android:text="@string/jvm_import_archive"
                android:textAllCaps="false"
                android:textColor="@color/rf_text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/rf_divider" />

            <TextView
                android:id="@+id/runtime_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jvm_runtime_checking"
                android:textColor="@color/rf_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/import_runtime_button"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/rf_control"
                android:text="@string/jvm_import_runtime"
                android:textAllCaps="false"
                android:textColor="@color/rf_text_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/advanced_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/jvm_show_advanced"
            android:textAllCaps="false"
            android:textColor="@color/rf_text_secondary" />

        <LinearLayout
            android:id="@+id/advanced_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jvm_diagnostics_title"
                android:textColor="@color/rf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diagnostic_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/jvm_no_diagnostics"
                android:textColor="@color/rf_text_secondary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/import_directory_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/rf_control"
                android:text="@string/jvm_import_directory"
                android:textAllCaps="false"
                android:textColor="@color/rf_text_primary" />

            <Button
                android:id="@+id/test_runtime_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/rf_control"
                android:text="@string/jvm_test_runtime"
                android:textAllCaps="false"
                android:textColor="@color/rf_text_primary" />

            <Button
                android:id="@+id/test_renderer_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/rf_control"
                android:text="@string/jvm_test_renderer"
                android:textAllCaps="false"
                android:textColor="@color/rf_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/jvm_boundary_short"
            android:textColor="@color/rf_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
