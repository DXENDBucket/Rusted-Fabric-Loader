{
  "schemaVersion": 1,
  "id": "rustedfabricmodmenu",
  "version": "${version}",
  "name": "Rusted Fabric Mod Menu",
  "description": "Adds an in-game list of loaded Java mods.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.endx.rustedfabricmodmenu.RustedFabricModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "rustedfabricapi": "*"
  },
  "custom": {
    "rustedfabric:multiplayer": {
      "mode": "client_only"
    }
  }
}
